{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
		// `module`, `moduleResolution`, and other resolution options
		// are inherited from ./.svelte-kit/tsconfig.json (bundler resolution).
	}
}
