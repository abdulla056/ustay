# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# Dev only. Generate a real one for any deployed environment: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef"
